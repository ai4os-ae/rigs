result
result-*
*.iso
*.qcow2

# Wireless credentials baked into a throwaway installer image. A plaintext PSK
# by necessity — see hosts/installer.nix — so it must never be committed.
/secrets/installer-wifi.nix

# Throwaway public keys added to an installer image for one install. Not secret
# in themselves, but machine-specific scratch that should not accrete in git.
/secrets/installer-keys.nix

# Agent scratch and local editor state
CLAUDE.md
.claude/*
!.claude/skills/
.aider*
.direnv/

# Python bytecode, from running nix/kernel-build/report.py by hand
__pycache__/

# `go build` in a package directory drops a ten-megabyte binary next to the
# source and names it after the directory. Nothing builds these for real — the
# packages under pkgs/ are built by Nix — so they are only ever scratch, and a
# binary that large is not something to discover in git history later.
/pkgs/rig-buildd/rig-buildd
/pkgs/rig-fleetd/rig-fleetd
/pkgs/rig-kiosk-server/rig-kiosk-server

# SBOMs from `nix run .#sbom -- <host>`
/sbom-*
